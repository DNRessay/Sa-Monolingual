{
  "Comment": "sa-languages-corpus: fetch every (language, source) pair, resuming each in chunks until its stream is exhausted or a safety cap is hit, then process each language into a clean deduped file, then push. A Catch on each task means one bad source or language can never take down the whole run -- that item is just marked failed and the run continues (INLINE-mode Map states ignore ToleratedFailurePercentage entirely; Catch is the mechanism that actually works here).",
  "StartAt": "FetchAll",
  "States": {
    "FetchAll": {
      "Type": "Map",
      "ItemsPath": "$.pairs",
      "ResultPath": "$.fetchResults",
      "MaxConcurrency": 6,
      "ItemProcessor": {
        "ProcessorConfig": { "Mode": "INLINE" },
        "StartAt": "InitFetchLoop",
        "States": {
          "InitFetchLoop": {
            "Type": "Pass",
            "Parameters": {
              "lang.$": "$.lang",
              "source.$": "$.source",
              "skip": 0,
              "chunk": 200000,
              "iteration": 0
            },
            "Next": "FetchChunk"
          },
          "FetchChunk": {
            "Type": "Task",
            "Resource": "${FetchFunctionArn}",
            "ResultPath": "$.result",
            "Retry": [
              {
                "ErrorEquals": ["States.ALL"],
                "IntervalSeconds": 15,
                "MaxAttempts": 3,
                "BackoffRate": 2.0
              }
            ],
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "ResultPath": "$.error",
                "Next": "FetchItemFailed"
              }
            ],
            "Next": "AdvanceFetchLoop"
          },
          "AdvanceFetchLoop": {
            "Type": "Pass",
            "Parameters": {
              "lang.$": "$.lang",
              "source.$": "$.source",
              "skip.$": "$.result.next_skip",
              "chunk.$": "$.chunk",
              "iteration.$": "States.MathAdd($.iteration, 1)",
              "exhausted.$": "$.result.exhausted"
            },
            "Next": "FetchLoopDone"
          },
          "FetchLoopDone": {
            "Type": "Choice",
            "Choices": [
              { "Variable": "$.exhausted", "BooleanEquals": true, "Next": "FetchSucceed" },
              { "Variable": "$.iteration", "NumericGreaterThanEquals": 25, "Next": "FetchSucceed" }
            ],
            "Default": "FetchChunk"
          },
          "FetchSucceed": { "Type": "Succeed" },
          "FetchItemFailed": {
            "Type": "Pass",
            "Parameters": {
              "lang.$": "$.lang",
              "source.$": "$.source",
              "failed": true,
              "error.$": "$.error"
            },
            "End": true
          }
        }
      },
      "Next": "ProcessAll"
    },
    "ProcessAll": {
      "Type": "Map",
      "ItemsPath": "$.langs",
      "ResultPath": "$.processResults",
      "MaxConcurrency": 3,
      "ItemSelector": {
        "lang.$": "$$.Map.Item.Value"
      },
      "ItemProcessor": {
        "ProcessorConfig": { "Mode": "INLINE" },
        "StartAt": "ProcessLang",
        "States": {
          "ProcessLang": {
            "Type": "Task",
            "Resource": "${ProcessFunctionArn}",
            "Retry": [
              {
                "ErrorEquals": ["States.ALL"],
                "IntervalSeconds": 30,
                "MaxAttempts": 2,
                "BackoffRate": 2.0
              }
            ],
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "ResultPath": "$.error",
                "Next": "ProcessItemFailed"
              }
            ],
            "End": true
          },
          "ProcessItemFailed": {
            "Type": "Pass",
            "Parameters": {
              "lang.$": "$.lang",
              "failed": true,
              "error.$": "$.error"
            },
            "End": true
          }
        }
      },
      "Next": "PushAll"
    },
    "PushAll": {
      "Type": "Map",
      "ItemsPath": "$.langs",
      "ResultPath": "$.pushResults",
      "MaxConcurrency": 3,
      "ItemSelector": {
        "lang.$": "$$.Map.Item.Value"
      },
      "ItemProcessor": {
        "ProcessorConfig": { "Mode": "INLINE" },
        "StartAt": "PushLang",
        "States": {
          "PushLang": {
            "Type": "Task",
            "Resource": "${PushFunctionArn}",
            "Retry": [
              {
                "ErrorEquals": ["States.ALL"],
                "IntervalSeconds": 30,
                "MaxAttempts": 2,
                "BackoffRate": 2.0
              }
            ],
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "ResultPath": "$.error",
                "Next": "PushItemFailed"
              }
            ],
            "End": true
          },
          "PushItemFailed": {
            "Type": "Pass",
            "Parameters": {
              "lang.$": "$.lang",
              "failed": true,
              "error.$": "$.error"
            },
            "End": true
          }
        }
      },
      "End": true
    }
  }
}
